# Example environment variables for docker-compose
# Copy this file to `.env` and update the values before running:
#   cp .env.example .env
#   edit .env

# Postgres credentials (do NOT commit real secrets)
POSTGRES_USER=pgsql_user
POSTGRES_PASSWORD=myC0mplexPwd
POSTGRES_DB=budgetplanner_db

# ASP.NET environment
ASPNETCORE_ENVIRONMENT=Development

# Optional: override the port mapping that compose uses
# API_HOST_PORT=5000
