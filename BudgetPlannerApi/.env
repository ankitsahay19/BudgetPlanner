# Local .env for docker-compose (DO NOT commit real secrets in public repos)
POSTGRES_USER=pgsql_user
POSTGRES_PASSWORD=myC0mplexPwd
POSTGRES_DB=budgetplanner_db
ASPNETCORE_ENVIRONMENT=Development
# Leave API_HOST_PORT unset to let docker-compose publish the container port to a random
# available host port (avoids conflicts). The start script will still select a free port
# when you run it and pass it to compose.
API_HOST_PORT=
MAX_WAIT_SECONDS=60
