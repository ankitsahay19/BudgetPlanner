@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="main-wrapper">
    <div class="row g-4 mb-4" id="dash">
        <div class="col-md-3">
            <div class="card p-3">
                <div class="text-muted small">Total Collections</div>
                <h3 class="mb-0 text-primary">$42,500</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3">
                <div class="text-muted small">Active Students</div>
                <h3 class="mb-0 text-success">124</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3">
                <div class="text-muted small">Pending Fees</div>
                <h3 class="mb-0 text-danger">$3,120</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3">
                <div class="text-muted small">Avg. Rating</div>
                <h3 class="mb-0 text-warning">4.9/5</h3>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="card-title mb-0">Fee Collection Analytics (Batch-Wise)</h5>
                    <span class="badge bg-light text-dark">FY 2024-25</span>
                </div>
                <div class="chart-container">
                    <canvas id="feeChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4" id="batches">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Batch Master List</h5>
            <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addBatchModal">
                <i class="bi bi-plus-circle me-1"></i> New Batch
            </button>
        </div>
        <div class="table-responsive p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Batch Code / Timing</th>
                        <th>Standard Fee</th>
                        <th>Duration (Start - End)</th>
                        <th>Strength</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <strong>React-ADV-01</strong><br>
                            <small class="text-muted">09:00 AM - 11:30 AM</small>
                        </td>
                        <td>$1,200</td>
                        <td>Mar 01 - May 30, 2024</td>
                        <td>15 / 20</td>
                        <td>
                            <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></button>
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <strong>Python-DS-04</strong><br>
                            <small class="text-muted">02:00 PM - 04:00 PM</small>
                        </td>
                        <td>$950</td>
                        <td>Feb 15 - June 15, 2024</td>
                        <td>22 / 25</td>
                        <td>
                            <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></button>
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mb-4" id="students">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">BatchStudent Details: <span class="text-primary small">React-ADV-01</span></h5>
        </div>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Student Name</th>
                        <th>Financial Split</th>
                        <th>Due Date</th>
                        <th>Training Status</th>
                        <th>Feedback (Rating)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <strong>John Wick</strong><br>
                            <span class="badge bg-info-subtle text-info status-pill">Discount: $100</span>
                        </td>
                        <td>
                            Paid: <span class="text-success fw-bold">$800</span><br>
                            Pending: <span class="text-danger fw-bold">$300</span>
                        </td>
                        <td>2024-04-10</td>
                        <td>
                            <div class="mb-1"><span class="badge bg-warning-subtle text-warning status-pill">In Progress</span></div>
                            <span class="badge bg-secondary status-pill">Cert. Not Issued</span>
                        </td>
                        <td>
                            <div class="small">
                                <strong>S <i class="bi bi-arrow-right"></i> T:</strong> 5.0 <i class="bi bi-star-fill text-warning"></i><br>
                                <strong>T <i class="bi bi-arrow-right"></i> S:</strong> "Focus on Hooks."
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="row" id="reviews">
        <div class="col-12">
            <div class="card p-4">
                <h5 class="mb-4">Recent Center Reviews</h5>
                <div class="list-group list-group-flush">
                    <div class="list-group-item d-flex justify-content-between align-items-start px-0 py-3">
                        <div class="ms-2 me-auto">
                            <div class="fw-bold">Excellent Facilities <span class="text-warning ms-2">★★★★★</span></div>
                            "The labs are well equipped and the trainers are professional."
                            <div class="small text-muted mt-1">- Sarah Connor, Python Course</div>
                        </div>
                        <button class="btn btn-sm btn-outline-success">Publish</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addBatchModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create New Training Batch</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form class="row g-3">
                    <div class="col-12"><label class="form-label">Batch Name</label><input type="text" class="form-control"></div>
                    <div class="col-md-6"><label class="form-label">Start Date</label><input type="date" class="form-control"></div>
                    <div class="col-md-6"><label class="form-label">End Date</label><input type="date" class="form-control"></div>
                    <div class="col-md-6"><label class="form-label">Fee ($)</label><input type="number" class="form-control"></div>
                    <div class="col-md-6"><label class="form-label">Timing</label><input type="time" class="form-control"></div>
                    <div class="col-12 text-end"><button type="submit" class="btn btn-primary">Save Batch</button></div>
                </form>
            </div>
        </div>
    </div>
</div>
