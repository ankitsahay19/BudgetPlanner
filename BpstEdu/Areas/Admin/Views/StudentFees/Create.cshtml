@model BpstEdu.DBModels.Student.StudentFee

@{
    ViewData["Title"] = "Create Payment";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-3">
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Payment - Step 1</h5>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input asp-for="StudentId" type="hidden" />

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="SubmittedFeeAmount" class="form-label">Amount</label>
                        <input asp-for="SubmittedFeeAmount" class="form-control" />
                        <span asp-validation-for="SubmittedFeeAmount" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="FeeSubmittingDate" class="form-label">Date</label>
                        <input asp-for="FeeSubmittingDate" type="date" class="form-control" />
                        <span asp-validation-for="FeeSubmittingDate" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label">Description</label>
                        <input asp-for="Description" class="form-control" />
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Payment Method</label>
                        <div class="d-flex gap-3">
                            <label class="form-check">
                                <input class="form-check-input" type="radio" name="paymentMethod" value="card" checked />
                                <span class="form-check-label">Card</span>
                            </label>
                            <label class="form-check">
                                <input class="form-check-input" type="radio" name="paymentMethod" value="upi" />
                                <span class="form-check-label">UPI</span>
                            </label>
                            <label class="form-check">
                                <input class="form-check-input" type="radio" name="paymentMethod" value="netbanking" />
                                <span class="form-check-label">Netbanking</span>
                            </label>
                        </div>
                    </div>

                    <div class="col-12 text-center mt-3">
                        <button type="submit" class="btn btn-primary">Proceed to Pay</button>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
