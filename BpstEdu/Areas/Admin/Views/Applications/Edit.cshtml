@model BpstEdu.DBModels.Application

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.ActiveTabName = "Applications";

}


<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">Edit Application</div>
        <div class="card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="UniqueId" />
                <div class="row">
                    <div class="col-md-4 text-center">
                        <img src="@Model.PhotoPath" class="img-thumbnail mb-3" style="width: 150px; height: 150px; object-fit: cover;" onerror="this.onerror=null;this.src='/images/default-profile.png';" alt="Profile Photo" />
                        <div class="mb-2"><strong>@Model.FullName</strong></div>
                        <div class="mb-2">DOB: @Model.DateOfBirth.ToShortDateString()</div>
                        <div class="mb-2">Age: @(DateTime.Now.Year - Model.DateOfBirth.Year - (DateTime.Now.DayOfYear < Model.DateOfBirth.DayOfYear ? 1 : 0))</div>
                        <div class="mb-2">Gender: @Model.Gender</div>
                        <div class="mb-2">Mobile: @Model.MobileNumber</div>
                        <div class="mb-2">Email: @Model.EmailId</div>
                    </div>
                    <div class="col-md-8">
                        <div class="row mb-2">
                            <div class="col-sm-6 mb-2">
                                <label asp-for="ApplicationId" class="form-label"></label>
                                <input asp-for="ApplicationId" class="form-control" readonly />
                            </div>
                            <div class="col-sm-6 mb-2">
                                <label asp-for="CollegeName" class="form-label"></label>
                                <input asp-for="CollegeName" class="form-control" readonly />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-6 mb-2">
                                <label asp-for="HighestQualification" class="form-label"></label>
                                <input asp-for="HighestQualification" class="form-control" readonly />
                            </div>
                            <div class="col-sm-6 mb-2">
                                <label asp-for="CreatedDate" class="form-label"></label>
                                <input asp-for="CreatedDate" class="form-control" readonly />
                            </div>
                        </div>
                        <div class="mb-2">
                            <label asp-for="Address" class="form-label"></label>
                            <textarea asp-for="Address" class="form-control" rows="2" readonly></textarea>
                        </div>
                        <div class="mb-2">
                            <label asp-for="Message" class="form-label"></label>
                            <textarea asp-for="Message" class="form-control" rows="2" readonly></textarea>
                        </div>
                        <div class="mb-2">
                            <label asp-for="Feedback" class="form-label"></label>
                            <textarea asp-for="Feedback" class="form-control" rows="2" readonly></textarea>
                        </div>
                        <div class="mb-2">
                            <label asp-for="ApplicationStatus" class="form-label"></label>
                            <select asp-for="ApplicationStatus" class="form-select">
@*                                 @foreach (var status in Enum.GetValues(typeof(BpstEdu.Data.CommonConstants.ApplicationStatus))) {
                                    <option value="@status" @(Model.ApplicationStatus.ToString() == status.ToString() ? "selected" : "")>@status</option>
                                }
 *@                            </select>
                        </div>
                        <div class="mb-2">
                            <label for="adminComment" class="form-label">Add Comment</label>
                            <textarea id="adminComment" name="adminComment" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="mb-2">
                            <label for="batchSelect" class="form-label">Enroll to Batch</label>
                            <select id="batchSelect" name="batchSelect" class="form-select">
                                <option value="">Select Batch</option>
                                <!-- Populate with available batches from controller/viewbag if needed -->
                            </select>
                        </div>
                        <div class="d-flex justify-content-between mt-3">
                            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                            <input type="submit" value="Update" class="btn btn-primary" />
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
