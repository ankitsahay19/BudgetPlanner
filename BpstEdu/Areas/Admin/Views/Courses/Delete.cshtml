@model BpstEdu.DBModels.Course

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Views/Shared/_AdminLayout.cshtml"; 
    ViewBag.ActiveTabName = "Courses";

}


<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-danger text-white">Delete Course</div>
        <div class="card-body">
            <h5 class="mb-3">Are you sure you want to delete this course?</h5>
            <dl class="row">
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CourseName)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.CourseName)</dd>
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Description)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Description)</dd>
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Fees)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Fees)</dd>
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CreatedDate)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.CreatedDate)</dd>
                <dt class="col-sm-3">@Html.DisplayNameFor(model => model.LastUpdatedDate)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.LastUpdatedDate)</dd>
            </dl>
            <form asp-action="Delete" class="d-flex justify-content-between align-items-center mt-4">
                <input type="hidden" asp-for="UniqueId" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                <input type="submit" value="Delete" class="btn btn-danger" />
            </form>
        </div>
    </div>
</div>
