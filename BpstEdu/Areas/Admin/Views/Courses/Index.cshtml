@model IEnumerable<BpstEdu.DBModels.Course>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.ActiveTabName = "Courses";
} 
@section Style {
     <link rel="stylesheet" href="/AppCss/table.css" /> 
} 
<div class="main-wrapper">  
    <div class="card shadow mb-4"> 
     <div class="card-header bg-success text-white"> Courses </div>      
        <div class="card-body">
            <a asp-action="Create" class="btn btn-outline-primary float-end">Create New</a> 
            <table id="courseTable" class="table table-hover table-striped" style="margin:0; width:100%; table-layout:fixed;">
            <colgroup>
                <col style="width:20%">
                <col style="width:50%">
                <col style="width:10%">
                <col style="width:10%">
            </colgroup>
            <thead>
                <tr>
                    <th>Course Name</th>
                    <th>Description</th>

                    <th class="date-col">Created Date</th>
                    <th></th> 
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.CourseName)</td>
                        <td>@Html.DisplayFor(modelItem => item.Description)</td>

                        <td class="date-col">@Html.DisplayFor(modelItem => item.CreatedDate)</td>
                         <td class="actions-col">
                            <a asp-action="Edit" asp-route-id="@item.UniqueId" title="Edit" class="me-2 text-primary"><i class="bi bi-pencil-square"></i></a>
                            <a asp-action="Details" asp-route-id="@item.UniqueId" title="Details" class="me-2 text-info"><i class="bi bi-info-circle"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.UniqueId" title="Delete" class="text-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table> 
        <div class="card-body" style="padding:0;"> </div>
    </div>
</div> 
@section Scripts {
    <script>
        $(document).ready(function () { 
            $('#courseTable').DataTable(); 
        });
    </script>
}