@model Application

@{
    ViewData["Title"] = "StudentApplications";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
    ViewBag.ActiveTabName = "Registration";
    var isSaved = false;
    if (TempData["SaveSuccess"] != null)
    {
        isSaved = (bool)TempData["SaveSuccess"];
    }
    if (ViewBag.SaveSuccess != null && ViewBag.SaveSuccess == true)
    {
        isSaved = true;
    }
}

<style>
    body {
         min-height: 100vh;
    }

    .card {
        border-radius: 15px;
    }

    .photo-box {
        border: 2px dashed #adb5bd;
        border-radius: 12px;
        padding: 15px;
        text-align: center;
        background: #f8f9fa;
    }

    .photo-preview {
        width: 150px;
        height: 150px;
        object-fit: cover;
        border-radius: 10px;
        margin-bottom: 10px;
    }

    .age-text {
        font-weight: 600;
        color: #0d6efd;
        margin-top: 8px;
    }

    .section-title {
        font-weight: 600;
        color: #0d6efd;
        margin: 25px 0 10px;
    }
</style>

<div class="container py-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <div class="d-flex align-items-center justify-content-between">
                <h5 class="mb-0">Student Registration</h5>
                <small class="text-light">Please provide accurate information. Fields marked with * are required.</small>
            </div>
        </div>
        <div class="card-body">
            <form class="form-horizontal" asp-action="StudentApplications" asp-controller="Home" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="ApplicationId" />
                <input type="hidden" asp-for="UniqueId" />

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                @if (isSaved)
                {
                    <div class="alert alert-success" role="alert">
                        Your registration was accepted successfully. We will contact you soon.
                    </div>
                }

                <div class="row g-4">

                    <!-- Photo Column -->
                    <div class="col-md-4">
                        <div class="photo-box">
                            <img id="preview"
                                 src="https://via.placeholder.com/150"
                                 class="photo-preview" />

                            <input type="file"
                                   name="Photo"
                                   id="Photo"
                                   accept="image/*"
                                   class="form-control"
                                   onchange="loadPhoto(event)" />

                            <div id="ageDisplay" class="age-text"></div>
                        </div>
                    </div>

                <div class="row">
                    <div class="col-12 col-sm-6 mb-3">
                        <label asp-for="FirstName" class="form-label">First name *</label>
                        <input type="text" asp-for="FirstName" placeholder="Student First Name" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6 mb-3">
                        <label asp-for="LastName" class="form-label">Last name *</label>
                        <input type="text" asp-for="LastName" placeholder="Student Last Name" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6 mb-3">
                        <label class="form-label">Gender</label>
                        <div class="d-flex gap-3 align-items-center">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="Gender" id="genderMale" value="Male">
                                <label class="form-check-label" for="genderMale">Male</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="Gender" id="genderFemale" value="Female">
                                <label class="form-check-label" for="genderFemale">Female</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="Gender" id="genderOther" value="Other">
                                <label class="form-check-label" for="genderOther">Other</label>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 mb-3">
                        <label class="form-label">Date of birth</label>
                        <input type="date" name="DateOfBirth" id="DateOfBirth" class="form-control" />
                    </div>

                    <div class="col-12 col-sm-6 mb-3">
                        <label asp-for="MobileNumber " class="form-label">Mobile Number</label>
                        <input type="text" asp-for="MobileNumber" placeholder="Mobile Number" class="form-control" />
                        <span asp-validation-for="MobileNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6 mb-3">
                        <label asp-for="EmailId" class="form-label">Email</label>
                        <input type="email" asp-for="EmailId" placeholder="you@example.com" class="form-control" />
                        <span asp-validation-for="EmailId" class="text-danger small"></span>
                    </div>


                    <div class="col-12 mb-3">
                        <label asp-for="Address" class="form-label">Address</label>
                        <input type="text" asp-for="Address" placeholder="Enter your full address with pin code." class="form-control" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6 mb-3">
                        <label asp-for="HighestQualification" class="form-label">Highest qualification</label>
                        <input type="text" asp-for="HighestQualification" placeholder="Your Highest Qualification" class="form-control" />
                        <span asp-validation-for="HighestQualification" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6 mb-3">
                        <label asp-for="CollegeName" class="form-label">College / Institution</label>
                        <input type="text" asp-for="CollegeName" placeholder="College Name & Board" class="form-control" />
                        <span asp-validation-for="CollegeName" class="text-danger small"></span>
                    </div>


                    <div class="col-12 mb-3">
                        <label asp-for="Message" class="form-label">Message / Query</label>
                        <textarea asp-for="Message" placeholder="Type your message / query" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Message" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-center mt-3">
                    <button type="submit" class="btn btn-primary btn-lg">Submit Application</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/appjs/common.js"></script>
    <script>
        (function () {
            var photo = document.getElementById('Photo');
            var preview = document.getElementById('photoPreview');
            if (!photo) return;
            photo.addEventListener('change', function (e) {
                var file = e.target.files && e.target.files[0];
                if (!file) {
                    preview.style.display = 'none';
                    preview.src = '#';
                    return;
                }
                var allowed = ['image/jpeg', 'image/png', 'image/jpg'];
                if (allowed.indexOf(file.type) === -1) {
                    alert('Only JPG and PNG images are allowed.');
                    e.target.value = '';
                    return;
                }
                if (file.size > 2 * 1024 * 1024) { // 2MB
                    alert('Maximum file size is 2MB.');
                    e.target.value = '';
                    return;
                }
                var reader = new FileReader();
                reader.onload = function (evt) {
                    preview.src = evt.target.result;
                    preview.style.display = 'inline-block';
                };
                reader.readAsDataURL(file);
            });
        })();
    </script>
}

 