@model Application

@{
    ViewData["Title"] = "StudentApplications";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
    ViewBag.ActiveTabName = "Registration";
    var isSaved = false;
    if (TempData["SaveSuccess"] != null)
    {
        isSaved = (bool)TempData["SaveSuccess"];
    }
    if (ViewBag.SaveSuccess != null && ViewBag.SaveSuccess == true)
    {
        isSaved = true;
    }
}


<div class="container py-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <div class="d-flex align-items-center justify-content-between">
                <h5 class="mb-0">Student Registration</h5>
                <small class="text-light">Please provide accurate information. Fields marked with * are required.</small>
            </div>
        </div>
        <div class="card-body">
                <form>

      <!-- 3 Column Layout -->
      <div class="row g-4">

        <!-- Column 1 : Photo -->
        <div class="col-md-4">
          <div class="photo-box">
            <img id="preview" src="https://via.placeholder.com/150" class="photo-preview"/>
            <input type="file" class="form-control" accept="image/*" onchange="loadPhoto(event)">
            <div id="ageDisplay" class="age-text"></div>
          </div>
        </div>

        <!-- Column 2 -->
        <div class="col-md-4">

          <!-- Row 1 -->
          <label class="form-label">First Name</label>
          <input type="text" class="form-control mb-3">

          <!-- Row 2 -->
          <label class="form-label">Gender</label>
          <select class="form-select mb-3">
            <option selected disabled>Select Gender</option>
            <option>Male</option>
            <option>Female</option>
            <option>Other</option>
          </select>

          <!-- Row 3 -->
          <label class="form-label">Mobile</label>
          <input type="tel" class="form-control">
        </div>

        <!-- Column 3 -->
        <div class="col-md-4">

          <!-- Row 1 -->
          <label class="form-label">Last Name</label>
          <input type="text" class="form-control mb-3">

          <!-- Row 2 -->
          <label class="form-label">Date of Birth</label>
          <input type="date" id="dob" class="form-control mb-3" onchange="calculateAge()">

          <!-- Row 3 -->
          <label class="form-label">Email</label>
          <input type="email" class="form-control">
        </div>

      </div>

      <!-- Address -->
      <div class="section-title">Address</div>
      <textarea class="form-control" rows="3" placeholder="Enter full address"></textarea>

      <!-- Qualification -->
      <div class="section-title">Highest Qualification</div>
      <input type="text" class="form-control">

      <!-- College -->
      <div class="section-title">College / Institution</div>
      <input type="text" class="form-control">

      <!-- Message -->
      <div class="section-title">Message / Query</div>
      <textarea class="form-control" rows="3" placeholder="Any message or query"></textarea>

      <div class="text-center mt-4">
        <button type="submit" class="btn btn-primary px-5">Submit Registration</button>
      </div>

    </form>
 
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/appjs/common.js"></script>

<script>
  function loadPhoto(event) {
    const preview = document.getElementById('preview');
    preview.src = URL.createObjectURL(event.target.files[0]);
  }

  function calculateAge() {
    const dob = document.getElementById('dob').value;
    if (dob) {
      const birthDate = new Date(dob);
      const diff = Date.now() - birthDate.getTime();
      const ageDate = new Date(diff);
      const age = Math.abs(ageDate.getUTCFullYear() - 1970);
      document.getElementById('ageDisplay').innerText = "Age: " + age + " years";
    }
  }
</script>
}

 