@model Application

@{
    ViewData["Title"] = "StudentApplications";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
    ViewBag.ActiveTabName = "Registration";
    var isSaved = false;
    if (TempData["SaveSuccess"] != null)
    {
        isSaved = (bool)TempData["SaveSuccess"];
    }
    if (ViewBag.SaveSuccess != null && ViewBag.SaveSuccess == true)
    {
        isSaved = true;
    }
}

<style>
    .card {
        border-radius: 15px;
    }

    .photo-box {
        border: 2px dashed #adb5bd;
        border-radius: 12px;
        padding: 15px;
        text-align: center;
        background: #f8f9fa;
    }

    .photo-preview {
        width: 18em;
        height: 9em;
        object-fit: cover;
        border-radius: 10px;
        margin-bottom: 10px;
    }

    .age-text {
        font-weight: 600;
        color: #0d6efd;
        margin-top: 8px;
    } 
</style> 

<div class="container py-4">
    <div class="card shadow-sm">
        <div class="card-header" style="background-color:black;color:white;">
            <div class="d-flex align-items-center justify-content-between">
                <h5 class="mb-0">Student Registration</h5>
                <small class="text-light">Please provide accurate information. Fields marked with * are required.</small>
            </div>
        </div>
        <div class="card-body">
            <form class="form-horizontal" asp-action="StudentApplications" asp-controller="Home" method="post" enctype="multipart/form-data">


                <div class="row g-4"> 
                    @if (isSaved)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert" style="margin: 20px 0;">
                            <strong>Success!</strong> Your registration has been submitted successfully. We will contact you soon with further details.
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    <!-- Column 1 : Photo -->
                    <div class="col-md-4">
                        <div class="photo-box">
                            <img id="preview" src="https://via.placeholder.com/150" class="photo-preview" />
                            <input type="file" id="photoInput" name="Photo" class="btn btn-outline-info" style="width:18em" accept="image/*" onchange="loadPhoto(event)" />
                            <div id="ageDisplay" class="age-text"></div>
                        </div>
                    </div> 

                    <div class="col-12 col-md-4">
                        <div class="mb-3">
                            <label asp-for="FirstName" class="form-label">First name *</label>
                            <input asp-for="FirstName" tabindex="1" required class="form-control" placeholder="First name" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Gender</label>
                            <select asp-for="Gender" tabindex="3" required class="form-select mb-3 form-control">
                                <option selected disabled>Select Gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MobileNumber"  class="form-label">Mobile number *</label>
                            <input asp-for="MobileNumber" tabindex="5" required class="form-control" placeholder="e.g. 8299101616" />
                            <span asp-validation-for="MobileNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Right: LastName, DOB, Email -->
                    <div class="col-12 col-md-4">
                        <div class="mb-3">
                            <label asp-for="LastName" class="form-label">Last name *</label>
                            <input asp-for="LastName" tabindex="2" required class="form-control" placeholder="Last name" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DateOfBirth"  class="form-label">Date of birth</label>
                            <input asp-for="DateOfBirth" tabindex="4" type="date" class="form-control" onchange="calculateAge()" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EmailId" class="form-label">Email</label>
                            <input asp-for="EmailId" tabindex="6" type="email" class="form-control" placeholder="you@example.com" />
                            <span asp-validation-for="EmailId" class="text-danger small"></span>
                        </div>
                    </div>

                </div>

                <div class="row mt-3">
                    <div class="col-12">
                        <label asp-for="Address"  class="form-label">Address</label>
                        <textarea asp-for="Address" tabindex="7" class="form-control" rows="2" placeholder="Enter your full address with pin code."></textarea>
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="HighestQualification" class="form-label">Highest qualification</label>
                        <input asp-for="HighestQualification" tabindex="8" class="form-control" />
                        <span asp-validation-for="HighestQualification" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="CollegeName" class="form-label">College / Institution</label>
                        <input asp-for="CollegeName" tabindex="9" class="form-control" />
                        <span asp-validation-for="CollegeName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-12">
                        <label asp-for="Message" class="form-label">Message / Query</label>
                        <textarea asp-for="Message" tabindex="10" class="form-control" rows="3" placeholder="Type your message / query"></textarea>
                        <span asp-validation-for="Message" class="text-danger small"></span>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <button type="submit"  tabindex="11" class="btn btn-primary px-5">Submit Registration</button>
                    <div asp-validation-summary="All" class="text-danger"></div>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/appjs/common.js"></script>

    <script>
        function loadPhoto(event) {
          const preview = document.getElementById('preview');
          preview.src = URL.createObjectURL(event.target.files[0]);
        }

        function calculateAge() {
          const dob = document.getElementById('DateOfBirth').value;
          if (dob) {
            const birthDate = new Date(dob);
            const diff = Date.now() - birthDate.getTime();
            const ageDate = new Date(diff);
            const age = Math.abs(ageDate.getUTCFullYear() - 1970);
            document.getElementById('ageDisplay').innerText = "Age: " + age + " years";
          }
        }
    </script>
}

