@{    // -- New active tab
    string activeTab = string.Empty;
    string activeTabName = "something...";
    if (!string.IsNullOrEmpty(ViewBag.activeTabName))
    {
        activeTabName = ViewBag.activeTabName;
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TechTrain Pro | Management Suite</title>

    <!-- CSS FIRST -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />

    <!-- Custom Styles moved to AppCss/appcss.css -->
    <link rel="stylesheet" href="/AppCss/appcss.css" />
    @RenderSection("Style", required: false)
</head>

<body>

    <div class="sidebar d-flex flex-column p-3">
        <div class="d-flex align-items-center mb-4 px-3">
            <i class="bi bi-cpu-fill fs-3 text-primary me-2"></i>
            <h4 class="mb-0">TechTrain</h4>
        </div>
        <ul class="nav nav-pills flex-column mb-auto">
            @if (activeTabName.Contains("Dashboard")) { activeTab = "active"; } else { activeTab = string.Empty; } 
            <li><a href="/Admin/home/dashboard" class="nav-link @activeTab"><i class="bi bi-grid-1x2-fill me-2"></i> Dashboard</a></li>

            @if (activeTabName.Contains("Applications")) { activeTab = "active"; } else { activeTab = string.Empty; } 
            <li><a href="/Admin/Applications" class="nav-link @activeTab"><i class="bi bi-grid-1x2-fill me-2"></i> Applications</a></li>

            @if (activeTabName.Contains("Courses")) { activeTab = "active"; } else { activeTab = string.Empty; }
            <li><a href="/Admin/Courses" class="nav-link @activeTab"><i class="bi bi-grid-1x2-fill me-2"></i> Courses</a></li>

            @if (activeTabName.Contains("Batches")) { activeTab = "active"; } else { activeTab = string.Empty; }
            <li><a href="/Admin/Batches" class="nav-link @activeTab"><i class="bi bi-grid-1x2-fill me-2"></i> Batches</a></li>
             @if (activeTabName.Contains("Students")) { activeTab = "active"; } else { activeTab = string.Empty; }
            <li><a href="/Admin/Students" class="nav-link @activeTab"><i class="bi bi-grid-1x2-fill me-2"></i> Students</a></li>
             @if (activeTabName.Contains("BatchStudents")) { activeTab = "active"; } else { activeTab = string.Empty; }
            <li><a href="/Admin/BatchStudents" class="nav-link @activeTab"><i class="bi bi-grid-1x2-fill me-2"></i> Batch Students</a></li>
 

            @if (activeTabName.Contains("batchS")) { activeTab = "active"; } else { activeTab = string.Empty; }
            <li><a href="#batches" class="nav-link @activeTab"><i class="bi bi-stack me-2"></i> Manage Batches</a></li>
            @if (activeTabName.Contains("Helper")) { activeTab = "active"; } else { activeTab = string.Empty; }
            <li><a href="#students" class="nav-link @activeTab"><i class="bi bi-people-fill me-2"></i> Enrollments</a></li>
            @if (activeTabName.Contains("Helper")) { activeTab = "active"; } else { activeTab = string.Empty; }
            <li><a href="#reviews" class="nav-link @activeTab"><i class="bi bi-chat-heart-fill me-2"></i> Reviews</a></li>
        </ul>
        <div class="px-3 pb-3">
            <div class="small text-muted">User: Admin (Lead)</div>
        </div>
    </div>
    @RenderBody()

    
<!-- jQuery (Load First) -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<!-- Bootstrap Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<!-- DataTables -->
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script> 
@RenderSection("Scripts", required: false)
</body>
</html>
